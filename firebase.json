{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json"],
    "cleanUrls": true,
    "headers": [{ "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] }],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
